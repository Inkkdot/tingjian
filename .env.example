# Copy to .env and adjust. Never commit real credentials.
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=tingjian

# Optional Bilibili login session for AI subtitle tracks. Keep it outside the repo.
# BILIBILI_COOKIE=SESSDATA=...; bili_jct=...; buvid3=...
# BILIBILI_COOKIE_FILE=C:/Users/me/.oceanbase-ai/bili-cookie.txt

# Set to 0 to force text-only mode (health endpoint reports the degradation).
TINGJIAN_EMBEDDING=1
# Semantic no-answer gate (cosine similarity); calibrated to 0.49 on the authored corpus.
TINGJIAN_MIN_SEMANTIC=0.49

# Frontend (apps/web): leave VITE_API_BASE empty for same-origin / dev proxy.
# VITE_API_BASE=http://127.0.0.1:8001
# VITE_DEMO=false
